# -------------------------------------------------------------
# APEX SOVEREIGN CORE PROTOCOL CONFIGURATION
# -------------------------------------------------------------

# Mode: PAPER (Risk-free simulation) or LIVE
MODE=PAPER

# Target Exchange (binance, bybit, kraken, okx, coinbase)
EXCHANGE_ID=binance

# Exchange API Credentials (Leave empty or testnet credentials for paper trading)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Use Exchange Testnet Sandbox (True/False)
SANDBOX=True

# Portfolio Initial Capital in USDT (Paper balance)
INITIAL_CAPITAL_USDT=10000.0

# Hard Insovency Kill-Switch Floor (If balance hits this number, bot kills process)
INSOLVENCY_FLOOR_USDT=9000.0

# Telegram Alerting (Optional - add your token and chat ID to receive live phone pings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (Optional - paste webhook URL for instant channel alerts)
DISCORD_WEBHOOK_URL=
